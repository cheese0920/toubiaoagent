{
  "version": 2,
  "coordinator": "technical-bid-orchestrator",
  "principles": {
    "chapter_agent_min": 2,
    "chapter_agent_max": 6,
    "minimalism_router": "config/minimalism-router.json",
    "prefer_deterministic_gate_before_review_agent": true,
    "require_source_trace": true,
    "require_human_review": true,
    "block_word_export_on_high_risk": true
  },
  "stages": [
    {
      "id": "intake",
      "agents": ["intake-librarian"],
      "default_execution_level": "L0",
      "context_policy": "checklist-and-artifact-refs",
      "agents_only_when": "资料无法按文件类型、元数据或人工清单完成隔离，需要语义判断版本、项目或标包归属",
      "depends_on": [],
      "deterministic_checks": ["ingest-sources", "check-sources"],
      "outputs": [
        "state/workflow-state.json",
        "inventory/source-readiness.json",
        "inventory/source-index.json",
        "inventory/project-whitelist.json",
        "inventory/rag-fragments.json"
      ]
    },
    {
      "id": "requirements",
      "agents": ["requirement-analyst"],
      "default_execution_level": "L1",
      "context_policy": "compact-state-and-artifact-refs",
      "depends_on": ["intake"],
      "deterministic_checks": ["shred-rfp", "check-requirements", "check-scoring-applicability", "check-scoring-map", "check-response-register"],
      "outputs": [
        "requirements/atomic-requirements.json",
        "requirements/marker-register.json",
        "requirements/rejection-clauses.json",
        "requirements/scoring-applicability.json",
        "requirements/scoring-map.json",
        "requirements/response-register.json",
        "requirements/mandatory-requirements.json",
        "requirements/format-rules.json",
        "requirements/exclusion-list.json"
      ],
      "human_gate": "逐条确认原子要点、* 与 ⭐ 的含义、废标/否决条款、当前标包评分组组合及逻辑边界、最高得分档原文、评分内容对象、质量标准、全局编写约束、我司响应口径和排除清单"
    },
    {
      "id": "planning",
      "agents": ["chapter-planner"],
      "default_execution_level": "L2",
      "context_policy": "compact-state-and-artifact-refs",
      "depends_on": ["requirements"],
      "deterministic_checks": ["check-plan"],
      "outputs": [
        "planning/chapter-plan.json",
        "planning/scoring-section-map.json",
        "planning/technical-requirement-section-map.json",
        "tasks/chapter-task-*.json"
      ],
      "human_gate": "确认一级章节严格符合招标文件技术投标格式，二级标题按评分分项顺序映射，三级标题与最高得分档评分内容对象逐项对应，三级以下结合项目实际，交叉内容已设置主响应、关联响应和去重策略，各 response_item_id 已映射到主响应章节和任务"
    },
    {
      "id": "grounding",
      "agents": ["content-grounder"],
      "default_execution_level": "L2",
      "context_policy": "task-scoped-sources-knowledge-cards-and-rejection-refs",
      "depends_on": ["planning"],
      "parallel": true,
      "deterministic_checks": ["check-grounding-pack", "check-paragraph-plan"],
      "outputs": ["grounding/*.json", "paragraph-plans/*.json"],
      "human_gate": "确认每个章节任务已有章节依据包和段落写作计划，已绑定允许评分组、评分项、技术规范、项目实际、已确认我司响应口径、来源引用、禁用变更和废标项"
    },
    {
      "id": "drafting",
      "agents": ["chapter-realizer-*"],
      "default_execution_level": "L3",
      "context_policy": "task-scoped-artifact-refs-only",
      "depends_on": ["grounding"],
      "parallel": true,
      "deterministic_checks": ["check-chapter-draft", "check-responses", "check-rejection"],
      "outputs": ["chapters/*.md", "evidence/*.json", "reviews/chapter-draft-*.json"]
    },
    {
      "id": "expansion",
      "agents": ["chapter-expander-*"],
      "default_execution_level": "L1",
      "context_policy": "single-chapter-artifact-refs-only",
      "depends_on": ["drafting"],
      "parallel": true,
      "deterministic_checks": ["check-expansion", "check-responses", "check-rejection"],
      "max_revision_rounds": 2,
      "on_validation_failure": "targeted-revision-then-human-review",
      "outputs": ["expanded/*.md", "reviews/expansion-*.json"]
    },
    {
      "id": "integration",
      "agents": ["integration-editor"],
      "default_execution_level": "L2",
      "context_policy": "expanded-section-refs-and-traceability-only",
      "depends_on": ["expansion"],
      "outputs": ["merged/technical-bid-draft.md", "merged/traceability.json"]
    },
    {
      "id": "review",
      "agents": ["compliance-reviewer", "rejection-reviewer", "residue-reviewer", "format-reviewer"],
      "default_execution_level": "L0",
      "context_policy": "deterministic-reports-first-agent-on-failure-only",
      "depends_on": ["integration"],
      "parallel": true,
      "deterministic_checks": ["check-sources", "check-requirements", "check-scoring-applicability", "check-scoring-map", "check-response-register", "check-plan", "check-grounding-pack", "check-paragraph-plan", "check-chapter-draft", "check-responses", "check-expansion", "check-rejection", "validate"],
      "agents_only_when": "确定性门禁发现问题且需要语义定位、误报判断或跨章节整改建议",
      "outputs": ["reviews/*.json"],
      "human_gate": "处理中风险问题并确认技术偏差"
    },
    {
      "id": "export",
      "agents": ["exporter"],
      "default_execution_level": "L0",
      "context_policy": "review-reports-and-merged-draft-only",
      "depends_on": ["review"],
      "outputs": ["output/技术投标文件-初稿.docx"]
    }
  ]
}
